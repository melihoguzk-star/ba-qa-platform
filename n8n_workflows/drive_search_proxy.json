{
  "name": "Drive Search Proxy for BA-QA Platform",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drive-search-proxy",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "queryString": "={{ $json.query }}",
        "limit": 20,
        "options": {}
      },
      "id": "google-drive-search",
      "name": "Google Drive Search",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [500, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "your-google-oauth-credential-id",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pass through all fields from Google Drive Search\nconst items = $input.all();\nconst results = items.map(item => {\n  const d = item.json;\n  return {\n    name: d.name || '',\n    id: d.id || '',\n    file_id: d.id || '',\n    webViewLink: d.webViewLink || d.alternateLink || ('https://drive.google.com/file/d/' + (d.id || '') + '/view'),\n    mimeType: d.mimeType || '',\n    modifiedTime: d.modifiedTime || d.modifiedDate || '',\n    size: d.size || d.fileSize || ''\n  };\n});\n\nreturn [{ json: { results } }];"
      },
      "id": "code-format",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.results) }}"
      },
      "id": "webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Google Drive Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive Search": {
      "main": [
        [
          {
            "node": "Format Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Results": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
