# BA&QA Intelligence Platform — Environment Variables

# ============================================================================
# API Keys
# ============================================================================

# Gemini API Key (single key)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# OR: Multiple Gemini API Keys (comma-separated, for rotation)
# GEMINI_API_KEYS=key-1,key-2,key-3

# Anthropic API Key (Claude)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============================================================================
# Database
# ============================================================================

# SQLite database path (relative to project root)
DATABASE_PATH=data/ba_platform.db

# ============================================================================
# ChromaDB Vector Store
# ============================================================================

# ChromaDB persistence directory
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Enable semantic search
ENABLE_SEMANTIC_SEARCH=true

# Enable auto-indexing for new documents
ENABLE_AUTO_INDEXING=true

# ============================================================================
# FastAPI Settings
# ============================================================================

# API host and port
HOST=0.0.0.0
PORT=8000

# Debug mode (enable auto-reload)
DEBUG=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API prefix
API_PREFIX=/api/v1

# ============================================================================
# Optional: External Integrations
# ============================================================================

# JIRA (optional)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Google Drive API (optional)
# GOOGLE_CREDENTIALS_PATH=credentials/google-credentials.json

# n8n Webhook (optional)
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/...
